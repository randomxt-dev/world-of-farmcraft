# Native and browser lobby: the game server plus the page, game data and WebSocket relay on
# 127.0.0.1:8090, which Caddy serves over https. Installed by deploy/setup.sh.
[Unit]
Description=Among Azeroth lobby (native and browser clients)
After=network-online.target
Wants=network-online.target
Conflicts=among-server.service

[Service]
User=among
WorkingDirectory=/opt/among-azeroth
EnvironmentFile=/etc/among-azeroth.env
# Unbraced $VARS split on spaces and vanish when empty: LAYOUT_ARGS and OWNER_ARGS are optional.
# `::` is dual-stack on Linux: IPv6 and IPv4 both reach the game, so a domain with AAAA works.
ExecStart=/opt/among-azeroth/among-host --bind :: --web 127.0.0.1:8090 --data /opt/among-azeroth/Data --www /opt/among-azeroth/www --public-url ${PUBLIC_URL} --advertise ${PUBLIC_IP} --lobby-code ${LOBBY_CODE} $LAYOUT_ARGS $OWNER_ARGS
Restart=always
RestartSec=2
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
# The survey (`.mark`) is the only thing the server writes.
ReadWritePaths=/opt/among-azeroth/benilla-config

[Install]
WantedBy=multi-user.target
