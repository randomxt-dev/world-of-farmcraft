# Native-only lobby: realmd on 3724 and the world server on 8085. Installed by deploy/setup.sh.
[Unit]
Description=Among Azeroth game server (native clients)
After=network-online.target
Wants=network-online.target
Conflicts=among-host.service

[Service]
User=among
WorkingDirectory=/opt/among-azeroth
EnvironmentFile=/etc/among-azeroth.env
# Unbraced $VARS split on spaces and vanish when empty: LAYOUT_ARGS and OWNER_ARGS are optional.
# `::` is dual-stack on Linux: IPv6 and IPv4 both reach the game, so a domain with AAAA works.
ExecStart=/opt/among-azeroth/among-server --bind :: --advertise ${PUBLIC_IP} --lobby-code ${LOBBY_CODE} $LAYOUT_ARGS $OWNER_ARGS
Restart=always
RestartSec=2
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
# The survey (`.mark`) is the only thing the server writes.
ReadWritePaths=/opt/among-azeroth/benilla-config

[Install]
WantedBy=multi-user.target
